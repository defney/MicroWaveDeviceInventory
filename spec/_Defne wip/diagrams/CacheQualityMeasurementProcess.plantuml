@startuml 01x_CyclicCacheQualityMeasurement
skinparam responseMessageBelowArrow true

title Cyclic Cache Quality Measurement Process

participant RO as ro
participant "/v1/embed-yourself" as mwdi
participant "/cache/control-construct={mountName}" as cache
participant "/live/control-construct={mountName}" as live
participant "/cache-quality-measurements" as store
participant "/analysis-ui" as client

ro -> mwdi : trigger_measurement()
activate mwdi

note over mwdi
Cyclic operation starts for comparing
cached and live control-constructs
end note

note over mwdi
Select a random device from list
end note

mwdi -> cache : GET control-construct={mountName}
cache --> mwdi : cachedControlConstruct

mwdi -> live : GET control-construct={mountName}
live --> mwdi : liveControlConstruct

note over mwdi
Compare cached and live versions
Calculate score based on differences
end note

mwdi -> store : PUT diff_summary (deviceId, score, timestamp)

' note over mwdi
' Deactivate until next cycle
' end note
' deactivate mwdi

note over client
Client triggers result queries
end note

client -> store : GET /cache-quality-measurements?deviceId=...
store --> client : diff_summary for device

client -> store : GET /cache-quality-measurements/grouped-by-vendor
store --> client : grouped_score_summary

@enduml